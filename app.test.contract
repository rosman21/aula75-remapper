// These run on the web against the simulated keyboard (data/src/sim.rs).

test "the simulated keyboard connects"
  clock data
  expect text "status-title" == "Connected through the 2.4 GHz receiver"
  expect text "link" == "2.4 GHz receiver"

test "a key becomes a combination on the Fn layer"
  clock data
  tap "tab-keys"
  clock data
  tap "layer-fn"
  clock data
  tap "key-9"
  clock settle
  tap "mod-cmd"
  tap "pick-k-6"
  clock data
  clock settle
  expect state keymap.rows.3 .keys.1 .action == "Copy (⌘C)"

test "a ready-made screenshot shortcut is one click"
  clock data
  tap "tab-keys"
  clock data
  tap "layer-fn"
  clock data
  tap "key-15"
  clock settle
  tap "pick-s-33-10"
  clock data
  clock settle
  expect state keymap.rows.3 .keys.2 .action == "Selected area (⇧⌘4)"

test "a number key takes modifiers, for a shortcut of your own"
  clock data
  tap "tab-keys"
  clock data
  tap "layer-fn"
  clock data
  tap "key-21"
  clock settle
  tap "mod-cmd"
  tap "mod-shift"
  tap "pick-k-34"
  clock data
  clock settle
  expect state keymap.rows.3 .keys.3 .action == "Screenshot and record (⇧⌘5)"

test "Caps Lock becomes Escape and the factory keys come back"
  clock data
  tap "tab-keys"
  clock data
  tap "key-3"
  clock settle
  tap "pick-k-41"
  clock data
  clock settle
  expect state keymap.rows.3 .keys.0 .action == "Esc"
  tap "restore"
  clock data
  expect state keymap.rows.3 .keys.0 .action == "Caps Lock"

test "lighting is read and written"
  clock data
  tap "tab-lighting"
  clock data
  expect state light.mode == 3
  type "effect" "2"
  clock data
  type "brightness" "9"
  clock data
  expect state light.mode == 2
  expect state light.brightness == 9

test "a macro is made, given steps, and written"
  clock data
  tap "tab-macros"
  type "macro-name" "Sign-off"
  tap "add-macro"
  clock data
  tap "macro-0"
  clock settle
  type "step-text" "Best, Ada"
  tap "add-step"
  clock data
  expect text "step-0" == "Type “Best, Ada”"
  type "step-text" "naïve"
  tap "add-step"
  clock data
  expect text "macro-error" == "A macro can't type “ï”: only US-keyboard characters work."

test "the board shows a key's new action as soon as it is saved"
  clock data
  tap "tab-keys"
  clock data
  tap "key-3"
  clock settle
  tap "pick-k-41"
  clock data
  clock settle
  expect tree has "keyboard"
  expect text "key-3" == "Escwas Caps"

test "a macro edit is written to the keyboard by itself"
  clock data
  tap "tab-macros"
  type "macro-name" "Hi"
  tap "add-macro"
  clock data
  tap "macro-0"
  clock settle
  type "step-text" "hi"
  tap "add-step"
  clock data
  clock data
  expect text "macro-sync" == "Saved to the keyboard"

test "the left Command key becomes Option"
  clock data
  tap "tab-keys"
  clock data
  tap "key-11"
  clock settle
  tap "pick-m-4"
  clock data
  clock settle
  expect state keymap.rows.5 .keys.1 .action == "Left Option"
  expect text "key-11" == "⌥ Optwas ⌘ Cmd"

test "Refresh reads the keys again"
  clock data
  tap "tab-keys"
  clock data
  tap "refresh-keys"
  clock data
  expect tree has "keyboard"
  expect state keymap.ok == true

test "Mac mode is called out, and Windows mode keeps ⌘ and ⌥ where they were"
  clock data
  tap "tab-keys"
  clock data
  expect state keymap.osMode == "mac"
  tap "use-windows"
  clock data
  clock settle
  expect state keymap.osMode == "windows"
  expect state keymap.macKeys == false
  expect state keymap.rows.5 .keys.1 .action == "Left Option"
  expect state keymap.rows.5 .keys.2 .action == "Left Command"

test "Mac keys: Windows mode with a Mac's top row, and Fn+E kept from Mac mode"
  clock data
  tap "tab-keys"
  clock data
  tap "mac-keys"
  clock data
  clock settle
  expect state keymap.osMode == "windows"
  expect state keymap.macKeys == true
  expect state keymap.rows.5 .keys.1 .action == "Left Option"
  expect state keymap.rows.0 .keys.12 .action == "Volume Up"
  tap "layer-fn"
  clock data
  expect state keymap.rows.0 .keys.12 .action == "F12"

test "a key changed in Mac mode sets up Mac keys first, so the change works"
  clock data
  expect state status.state == "ready"
  tap "tab-keys"
  clock data
  expect state keymap.osMode == "mac"
  tap "key-78"
  clock settle
  tap "pick-s-33-10"
  clock data
  clock settle
  expect state keymap.osMode == "windows"
  expect state keymap.macKeys == true
  expect state keymap.rows.0 .keys.12 .action == "Selected area (⇧⌘4)"
